# AgentForge backend environment (copy to .env for local overrides)
AGENTFORGE_ENVIRONMENT=development
AGENTFORGE_DEBUG=true

# PostgreSQL connection (docker-compose provides this automatically).
# Leave unset to fall back to a local SQLite file (sqlite:///./agentforge.db).
AGENTFORGE_DATABASE_URL=postgresql+psycopg2://agentforge:agentforge@localhost:5432/agentforge

# Comma-separated CORS origins for the Next.js dashboard.
AGENTFORGE_CORS_ORIGINS=["http://localhost:3000"]

# --- Auth / RBAC (Phase 1C) ---
# Set to true to enforce JWT/API-key auth + RBAC on all data endpoints.
AGENTFORGE_AUTH_ENABLED=false
AGENTFORGE_JWT_SECRET_KEY=change-me-in-production
AGENTFORGE_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Redis (optional; caching + rate limiting; graceful fallback if unset) ---
AGENTFORGE_REDIS_URL=redis://localhost:6379/0
AGENTFORGE_RATE_LIMIT_PER_MINUTE=600
AGENTFORGE_CACHE_TTL_SECONDS=15
